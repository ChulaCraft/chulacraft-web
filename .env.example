NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SUPABASE_SECRET_KEY=

# Optional: the address shown to players on the landing page.
NEXT_PUBLIC_MINECRAFT_SERVER_ADDRESS=

# Optional: the Vercel Analytics page linked from /admin/insights (hidden when unset).
# NEXT_PUBLIC_VERCEL_ANALYTICS_URL=https://vercel.com/<team>/<project>/analytics


# Server console (/admin/server): Ed25519 private key (PEM; "\n" escapes are fine)
# that signs tokens for chulacraft-server-manager, and where the manager lives.
MCSV_JWT_PRIVATE_KEY=
MCSV_MANAGER_URL=https://mc.chulacraft.com/api/mcsv_manager

# Bearer token for GET /api/ops/health, probed by the Discord bot's status monitor.
# Server-only; generate with `openssl rand -hex 32`. Unset = the endpoint always answers 401.
OPS_HEALTH_TOKEN=
